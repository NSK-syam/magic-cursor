{
  "manifest_version": 3,
  "name": "Magic Cursor \u2014 pointer autofill",
  "version": "0.5.2",
  "description": "Save your details once. Hover near an application field to fill a matching value.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "minimum_chrome_version": "102",
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Magic Cursor",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "options_page": "index.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/matcher.js",
        "src/answers.js",
        "src/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
